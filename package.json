{
  "name": "Gobble Beta",
  "version": "0.0.1",
  "scripts": {
    "avatar:dev": "node .Tmp/avatar/avatar/editor/serve-preview.cjs",
    "avatar:sync": "node scripts/import-avatar-workshop.mjs --families=hair,headwear",
    "avatar:import-hair": "python scripts/import-avatar-hair-pack.py && npm run avatar:sync",
    "dev": "node scripts/generate-music-manifest.js && vite",
    "build": "node scripts/generate-music-manifest.js && node ./node_modules/vite/bin/vite.js build",
    "benchmark:bigscore": "node server/scripts/benchmark-bigscore.mjs",
    "definitions:build": "node scripts/build-wiktionary-definitions.mjs",
    "definitions:import": "node server/scripts/import-definitions-db.mjs",
    "definitions:themes": "node server/scripts/backfill-game-semantic-themes.mjs",
    "definitions:semantic-embeddings": "node server/scripts/backfill-game-semantic-themes.mjs",
    "definitions:facts": "node server/scripts/backfill-word-linguistic-facts.mjs",
    "rarity:build": "node server/scripts/build-word-rarity.mjs",
    "ocid:pool:build": "node server/scripts/build-ocid-target-pool.mjs",
    "target-wait:build": "node server/scripts/build-target-wait-puzzles.mjs",
    "training:pool:build": "node server/scripts/build-training-pools.mjs",
    "training:pool:verify": "node server/scripts/verify-training-pools.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "canvas-confetti": "^1.9.4",
    "pixi.js": "8.21.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io-client": "^4.8.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.21"
  }
}
